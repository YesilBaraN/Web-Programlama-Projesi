@model IEnumerable<FitnessProje.Models.RandevuSistemi>
@{
    ViewData["Title"] = "Randevu Yönetimi";
}

<h2 class="fw-bold mb-4 text-danger">Randevu Talepleri</h2>

<div class="card shadow-sm border-0 rounded-4 overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="bg-dark text-white">
                <tr>
                    <th class="ps-4">Üye Bilgisi</th>
                    <th>Tarih</th>
                    <th>Hizmet / Eğitmen</th>
                    <th>Durum</th>
                    <th class="text-end pe-4">İşlem</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="ps-4">
                            <div class="fw-bold">@item.Uye?.Ad @item.Uye?.Soyad</div>
                            <small class="text-muted">@item.Uye?.Email</small>
                        </td>
                        <td class="fw-bold text-dark">
                            @item.RandevuTarihi.ToString("dd.MM.yyyy") <br />
                            <small class="text-muted">@item.RandevuTarihi.ToString("HH:mm")</small>
                        </td>
                        <td>
                            <span class="badge bg-light text-dark border">@item.Hizmet?.HizmetAdi</span>
                            <div class="small mt-1 text-muted">@item.Antrenör?.AdSoyad</div>
                        </td>
                        <td>
                            @if (item.Durum == "OnayBekliyor")
                            {
                                <span class="badge bg-warning text-dark">Bekliyor</span>
                            }
                            else if (item.Durum == "Onaylandi")
                            {
                                <span class="badge bg-success">Onaylandı</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Reddedildi</span>
                            }
                        </td>
                        <td class="text-end pe-4">
                            <div class="d-flex justify-content-end gap-2">

                                @if (item.Durum == "OnayBekliyor")
                                {
                                    <div class="btn-group shadow-sm rounded-pill" role="group">
                                        <form asp-action="DurumDegistir" method="post">
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <input type="hidden" name="durum" value="Onaylandi" />
                                            <button type="submit" class="btn btn-sm btn-success rounded-start-pill px-3" title="Onayla"><i class="bi bi-check-lg"></i></button>
                                        </form>
                                        <form asp-action="DurumDegistir" method="post">
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <input type="hidden" name="durum" value="Iptal" />
                                            <button type="submit" class="btn btn-sm btn-warning rounded-end-pill px-3" title="Reddet"><i class="bi bi-x-lg"></i></button>
                                        </form>
                                    </div>
                                }
                                else
                                {
                                    <span class="badge bg-light text-muted border align-self-center">İşlem Yapıldı</span>
                                }

                                <!-- SİLME BUTONU (Her durumda görünür) -->
                                <form asp-action="Sil" method="post" class="d-inline silme-formu">
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <button type="button" class="btn btn-sm btn-outline-danger rounded-pill px-3 ms-2" onclick="silmeOnayi(this)">
                                        <i class="bi bi-trash"></i> Sil
                                    </button>
                                </form>

                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
@section Scripts {
    <script>
        function silmeOnayi(button) {
            Swal.fire({
                title: 'Emin misiniz?',
                text: "Bu randevu kalıcı olarak silinecek! Üyeye bildirim gönderilecek.",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#3085d6',
                confirmButtonText: 'Evet, Sil!',
                cancelButtonText: 'İptal'
            }).then((result) => {
                if (result.isConfirmed) {
                    // Kullanıcı evet derse, butonu kapsayan formu gönder
                    button.closest('form').submit();
                }
            })
        }
    </script>
}