@model IEnumerable<FitnessProje.Models.RandevuSistemi>
@{
    ViewData["Title"] = "Randevularım";
}

<h2 class="fw-bold mb-4">Randevularım</h2>

@if (!Model.Any())
{
    <div class="alert alert-light border rounded-4 text-center p-5 shadow-sm">
        <i class="bi bi-calendar-x fs-1 text-muted"></i>
        <h4 class="mt-3">Henüz randevunuz yok.</h4>
        <a asp-controller="Home" asp-action="Index" class="btn btn-primary mt-3 rounded-pill">Hemen Randevu Al</a>
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var item in Model)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 shadow-sm border-0 rounded-4 position-relative overflow-hidden">
                    <!-- Durum Çubuğu -->
                    <div class="position-absolute top-0 start-0 w-100 h-100" style="pointer-events: none; border-left: 6px solid @(item.Durum == "Onaylandi" ? "#2ecc71" : (item.Durum == "Iptal" ? "#e74c3c" : "#f1c40f"));"></div>

                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <h5 class="fw-bold mb-0">@item.Hizmet?.HizmetAdi</h5>
                            @if (item.Durum == "OnayBekliyor")
                            {
                                <span class="badge bg-warning text-dark">Bekliyor</span>
                            }
                            else if (item.Durum == "Onaylandi")
                            {
                                <span class="badge bg-success">Onaylandı</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">İptal</span>
                            }
                        </div>

                        <p class="mb-1 text-muted"><i class="bi bi-person-fill me-2"></i> @item.Antrenör?.AdSoyad</p>
                        <p class="mb-0 fw-bold fs-5 text-primary">
                            <i class="bi bi-calendar-event me-2"></i> @item.RandevuTarihi.ToString("dd.MM.yyyy HH:mm")
                        </p>
                    </div>
                </div>
            </div>
        }
    </div>
}