@{
    ViewData["Title"] = "Randevu Al";
}

<div class="container mt-4">
    <div class="row g-4">
        <!-- SOL: FORM -->
        <div class="col-md-7">
            <div class="card shadow border-0 rounded-4 h-100">
                <div class="card-header bg-white py-3">
                    <h4 class="mb-0 fw-bold">Randevu Detayları</h4>
                </div>
                <div class="card-body p-4">
                    @if (TempData["Hata"] != null)
                    {
                        <div class="alert alert-danger rounded-3">
                            <i class="bi bi-exclamation-circle-fill me-2"></i> @TempData["Hata"]
                        </div>
                    }

                    <form asp-action="Al" method="post">
                        <input type="hidden" name="hizmetId" value="@ViewBag.HizmetId" />

                        <div class="mb-4">
                            <label class="form-label fw-bold text-muted">Eğitmen Seçiniz</label>
                            <select name="antrenorId" class="form-select form-select-lg rounded-3" asp-items="ViewBag.Antrenorler" required>
                                <option value="">-- Lütfen Seçiniz --</option>
                            </select>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold text-muted">Tarih ve Saat</label>
                            <input type="datetime-local" name="tarih" class="form-control form-control-lg rounded-3"
                                   min="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")" required />
                        </div>

                        <button type="submit" class="btn btn-primary btn-lg w-100 rounded-pill shadow-sm">
                            Randevuyu Onayla <i class="bi bi-arrow-right-short"></i>
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <!-- SAĞ: BİLGİ KARTI -->
        <div class="col-md-5">
            <div class="card bg-dark text-white rounded-4 shadow-lg border-0 h-100">
                <div class="card-body p-5 d-flex flex-column justify-content-center text-center">
                    <h5 class="text-white-50 text-uppercase ls-2">Seçilen Hizmet</h5>
                    <h2 class="display-5 fw-bold mb-4">@ViewBag.HizmetAdi</h2>

                    <div class="d-flex justify-content-around mb-4">
                        <div>
                            <i class="bi bi-clock fs-2 text-warning"></i>
                            <div class="mt-2 fw-bold">@ViewBag.Sure Dk</div>
                        </div>
                        <div>
                            <i class="bi bi-tag fs-2 text-success"></i>
                            <div class="mt-2 fw-bold">@ViewBag.Ucret TL</div>
                        </div>
                    </div>
                    <hr class="border-secondary" />
                    <p class="small text-white-50 mb-0">Lütfen eğitmenin çalışma saatlerine dikkat ediniz.</p>
                </div>
            </div>
        </div>
    </div>
</div>