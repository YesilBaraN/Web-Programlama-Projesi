@model FitnessProje.Models.Hizmetler
@{
    ViewData["Title"] = "Hizmet Ekle";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow-lg border-0 rounded-4">
            <div class="card-header bg-white py-3 border-0">
                <h4 class="fw-bold mb-0 text-primary">Yeni Hizmet Oluştur</h4>
            </div>
            <div class="card-body p-4">
                <form asp-action="Create" enctype="multipart/form-data">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Hizmet Adı</label>
                        <input asp-for="HizmetAdi" class="form-control form-control-lg rounded-3" placeholder="Örn: Pilates" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Açıklama</label>
                        <textarea asp-for="Aciklama" class="form-control rounded-3" rows="3"></textarea>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Süre (Dakika)</label>
                            <div class="input-group">
                                <input asp-for="SureDakika" type="number" class="form-control rounded-start-3" />
                                <span class="input-group-text rounded-end-3">dk</span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Ücret</label>
                            <div class="input-group">
                                <input asp-for="Ucret" type="number" class="form-control rounded-start-3" />
                                <span class="input-group-text rounded-end-3">TL</span>
                            </div>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-bold">Kapak Görseli</label>
                        <input type="file" name="resimDosyasi" class="form-control rounded-3" />
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-light rounded-pill px-4">İptal</a>
                        <button type="submit" class="btn btn-primary rounded-pill px-4 shadow-sm">Kaydet</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>