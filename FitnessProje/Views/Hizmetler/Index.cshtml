@model IEnumerable<FitnessProje.Models.Hizmetler>

@{
    ViewData["Title"] = "Hizmetler";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Hizmet Listesi</h2>
        <a asp-action="Create" class="btn btn-success">+ Yeni Hizmet Ekle</a>
    </div>

    <table class="table table-bordered table-striped">
        <thead class="table-dark">
            <tr>
                <th>Resim</th>
                <th>Hizmet Adı</th>
                <th>Ücret</th>
                <th>Süre (Dk)</th>
                <th>İşlemler</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        @if (!string.IsNullOrEmpty(item.ResimUrl))
                        {
                            <img src="@item.ResimUrl" width="50" height="50" style="object-fit:cover" />
                        }
                    </td>
                    <td>@item.HizmetAdi</td>
                    <td>@item.Ucret TL</td>
                    <td>@item.SureDakika dk</td>
                    <td>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger" onclick="return confirm('Silmek istediğine emin misin?');">Sil</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>