@model IEnumerable<FitnessProje.Models.Hizmetler>
@{
    ViewData["Title"] = "Hizmet Yönetimi";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-0">Hizmetler</h2>
        <p class="text-muted">Spor salonu hizmetlerini yönet</p>
    </div>
    <a asp-action="Create" class="btn btn-primary rounded-pill shadow-sm">
        <i class="bi bi-plus-lg"></i> Yeni Hizmet
    </a>
</div>

<div class="card shadow-sm border-0 rounded-4 overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="bg-light">
                <tr>
                    <th class="ps-4">Görsel</th>
                    <th>Hizmet Adı</th>
                    <th>Ücret</th>
                    <th>Süre</th>
                    <th class="text-end pe-4">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="ps-4">
                            @if (!string.IsNullOrEmpty(item.ResimUrl))
                            {
                                <img src="@item.ResimUrl" class="rounded-3 shadow-sm" width="60" height="60" style="object-fit:cover" />
                            }
                        </td>
                        <td class="fw-bold">@item.HizmetAdi</td>
                        <td class="text-success fw-bold">@item.Ucret.ToString("N0") TL</td>
                        <td><span class="badge bg-secondary text-light">@item.SureDakika dk</span></td>
                        <td class="text-end pe-4">
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger rounded-pill" onclick="return confirm('Silmek istediğine emin misin?');">
                                <i class="bi bi-trash"></i> Sil
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>