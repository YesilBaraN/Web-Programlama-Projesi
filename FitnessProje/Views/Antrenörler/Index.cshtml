@model IEnumerable<FitnessProje.Models.Antrenör>
@{
    ViewData["Title"] = "Antrenör Yönetimi";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-0">Antrenörler</h2>
        <p class="text-muted">Eğitmen kadrosunu yönet</p>
    </div>
    <a asp-action="Create" class="btn btn-primary rounded-pill shadow-sm">
        <i class="bi bi-plus-lg"></i> Yeni Antrenör
    </a>
</div>

<div class="card shadow-sm border-0 rounded-4 overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="bg-light">
                <tr>
                    <th class="ps-4">Profil</th>
                    <th>Ad Soyad</th>
                    <th>Uzmanlık</th>
                    <th>Ders</th>
                    <th>Saatler</th>
                    <th class="text-end pe-4">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="ps-4">
                            @if (!string.IsNullOrEmpty(item.FotoUrl))
                            {
                                <img src="@item.FotoUrl" class="rounded-circle border border-2 border-white shadow-sm" width="50" height="50" style="object-fit:cover" />
                            }
                        </td>
                        <td class="fw-bold">@item.AdSoyad</td>
                        <td>@item.UzmanlikAlani</td>
                        <td><span class="badge bg-info text-dark">@item.Hizmet?.HizmetAdi</span></td>
                        <td class="small text-muted">@item.BaslangicSaati - @item.BitisSaati</td>
                        <td class="text-end pe-4">
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger rounded-pill" onclick="return confirm('Silmek istediğine emin misin?');">
                                <i class="bi bi-trash"></i> Sil
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>