@model IEnumerable<FitnessProje.Models.Antrenör>

@{
    ViewData["Title"] = "Antrenörler";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Antrenör Listesi</h2>
        <a asp-action="Create" class="btn btn-success">+ Yeni Antrenör Ekle</a>
    </div>

    <table class="table table-hover table-bordered">
        <thead class="table-dark">
            <tr>
                <th>Fotoğraf</th>
                <th>Ad Soyad</th>
                <th>Uzmanlık</th>
                <th>Verdiği Ders</th>
                <th>Çalışma Saatleri</th>
                <th>İşlemler</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                    <tr>
                        <td>
                        @if (!string.IsNullOrEmpty(item.FotoUrl))
                        {
                                    <img src="@item.FotoUrl" class="rounded-circle" width="50" height="50" style="object-fit:cover" />
                        }
                        </td>
                        <td>@item.AdSoyad</td>
                        <td>@item.UzmanlikAlani</td>
                        <td>
                            <span class="badge bg-info text-dark">@item.Hizmet?.HizmetAdi</span>
                        </td>
                        <td>@item.BaslangicSaati - @item.BitisSaati</td>
                        <td>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger" onclick="return confirm('Silmek istediğine emin misin?');">Sil</a>
                        </td>
                    </tr>
            }
        </tbody>
    </table>
</div>