@{
    ViewData["Title"] = "AI Neural Coach";
}

<!-- ÖZEL CSS: Sadece bu sayfaya özgü fütüristik stiller -->
<style>
    /* Arka Plan: Hareketli ve Derinlikli */
    body {
        background-color: #f0f2f5;
        background-image:
            radial-gradient(at 0% 0%, hsla(253,16%,7%,1) 0, transparent 50%),
            radial-gradient(at 50% 0%, hsla(225,39%,30%,1) 0, transparent 50%),
            radial-gradient(at 100% 0%, hsla(339,49%,30%,1) 0, transparent 50%);
        background-attachment: fixed;
        min-height: 100vh;
    }

    /* Glassmorphism Kart Yapısı */
    .glass-panel {
        background: rgba(255, 255, 255, 0.85);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        border: 1px solid rgba(255, 255, 255, 0.6);
        border-radius: 24px;
        box-shadow: 0 8px 32px 0 rgba(31, 38, 135, 0.15);
    }

    /* Sol Panel: Kontrol Merkezi */
    .control-panel {
        border-right: 1px solid rgba(0,0,0,0.05);
    }

    /* Form Elemanları */
    .form-label-custom {
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 1px;
        color: #6c757d;
        font-weight: 700;
        margin-bottom: 8px;
    }

    .custom-input {
        background: #f8f9fa;
        border: 2px solid transparent;
        border-radius: 12px;
        padding: 12px 15px;
        transition: all 0.3s ease;
        font-weight: 600;
        color: #2c3e50;
    }

    .custom-input:focus {
        background: #fff;
        border-color: #667eea;
        box-shadow: 0 0 0 4px rgba(102, 126, 234, 0.1);
        outline: none;
    }

    /* Özel Radyo Butonları (Cinsiyet Seçimi) */
    .gender-selector input[type="radio"] {
        display: none;
    }
    .gender-selector label {
        display: block;
        padding: 12px;
        text-align: center;
        border: 2px solid #e9ecef;
        border-radius: 12px;
        cursor: pointer;
        transition: all 0.3s;
        font-weight: 600;
        color: #adb5bd;
    }
    .gender-selector input[type="radio"]:checked + label {
        border-color: #667eea;
        background: rgba(102, 126, 234, 0.1);
        color: #667eea;
    }

    /* Hedef Kartları */
    .goal-card {
        cursor: pointer;
        border: 2px solid #e9ecef;
        border-radius: 15px;
        padding: 15px;
        transition: all 0.3s;
    }
    .goal-card:hover {
        transform: translateY(-3px);
        border-color: #cbd5e0;
    }
    .goal-card.active {
        border-color: #764ba2;
        background: rgba(118, 75, 162, 0.05);
    }
    .goal-card i {
        font-size: 1.5rem;
        margin-bottom: 10px;
        display: block;
    }

    /* Generate Button */
    .btn-generate {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        border: none;
        padding: 15px;
        border-radius: 15px;
        font-weight: 700;
        letter-spacing: 1px;
        text-transform: uppercase;
        width: 100%;
        position: relative;
        overflow: hidden;
        transition: all 0.3s;
    }
    .btn-generate:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 20px rgba(118, 75, 162, 0.3);
        color: white;
    }

    /* AI Sonuç Alanı */
    .ai-output-area {
        background: #ffffff;
        border-radius: 20px;
        min-height: 100%;
        position: relative;
    }

    .ai-typing {
        font-family: 'Courier New', Courier, monospace;
        line-height: 1.6;
        color: #2d3436;
    }

    /* Loading Animasyonu */
    .ai-loader {
        display: flex;
        justify-content: center;
        align-items: center;
        height: 300px;
        flex-direction: column;
    }
    .pulse-ring {
        display: block;
        width: 60px;
        height: 60px;
        border-radius: 50%;
        background: #764ba2;
        animation: pulse 2s infinite;
    }
    @@keyframes pulse {
        0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(118, 75, 162, 0.7); }
        70% { transform: scale(1); box-shadow: 0 0 0 30px rgba(118, 75, 162, 0); }
        100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(118, 75, 162, 0); }
    }
</style>

<div class="container py-5">

    <!-- Başlık Alanı -->
    <div class="text-center mb-5 text-white" data-aos="fade-down">
        <div class="d-inline-flex align-items-center justify-content-center bg-white bg-opacity-10 rounded-pill px-4 py-2 mb-3 backdrop-blur">
            <span class="badge bg-primary rounded-pill me-2">BETA</span>
            <span class="small fw-bold letter-spacing-1">GOOGLE GEMINI 1.5 ENGINE</span>
        </div>
        <h1 class="display-4 fw-bold">AI Neural Coach</h1>
        <p class="text-white-50">Sadece senin için tasarlanmış, biyometrik verilerine dayalı akıllı antrenman sistemi.</p>
    </div>

    <!-- ANA PANEL -->
    <div class="glass-panel overflow-hidden" data-aos="zoom-in" data-aos-duration="1000">
        <div class="row g-0">

            <!-- SOL TARAFF: GİRDİ PANELİ -->
            <div class="col-lg-4 p-4 p-md-5 bg-white control-panel">
                <h4 class="fw-bold mb-4 text-dark"><i class="bi bi-sliders me-2"></i>Parametreler</h4>

                <form asp-action="OneriAl" method="post" id="aiForm" onsubmit="startProcessing()">

                    <!-- Cinsiyet -->
                    <div class="mb-4">
                        <label class="form-label-custom">Biyolojik Kimlik</label>
                        <div class="row g-2 gender-selector">
                            <div class="col-6">
                                <input type="radio" id="male" name="cinsiyet" value="Erkek" checked>
                                <label for="male"><i class="bi bi-gender-male me-1"></i> Erkek</label>
                            </div>
                            <div class="col-6">
                                <input type="radio" id="female" name="cinsiyet" value="Kadın">
                                <label for="female"><i class="bi bi-gender-female me-1"></i> Kadın</label>
                            </div>
                        </div>
                    </div>

                    <!-- Metrikler -->
                    <div class="mb-4">
                        <label class="form-label-custom">Vücut Metrikleri</label>
                        <div class="row g-3">
                            <div class="col-4">
                                <input type="number" name="yas" class="form-control custom-input text-center" placeholder="Yaş" value="@ViewBag.Yas" required>
                            </div>
                            <div class="col-4">
                                <input type="number" name="kilo" class="form-control custom-input text-center" placeholder="Kg" value="@ViewBag.Kilo" required>
                            </div>
                            <div class="col-4">
                                <input type="number" name="boy" class="form-control custom-input text-center" placeholder="Cm" value="@ViewBag.Boy" required>
                            </div>
                        </div>
                    </div>

                    <!-- Hedef Seçimi (Görsel Kartlar) -->
                    <div class="mb-5">
                        <label class="form-label-custom">Ana Hedef</label>
                        <input type="hidden" name="hedef" id="selectedGoal" value="Hızlı Kilo Verme">

                        <div class="row g-2">
                            <div class="col-6">
                                <div class="goal-card active text-center" onclick="selectGoal(this, 'Hızlı Kilo Verme')">
                                    <i class="bi bi-lightning-charge-fill text-warning"></i>
                                    <div class="small fw-bold">Kilo Ver</div>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="goal-card text-center" onclick="selectGoal(this, 'Kas Kütlesi Kazanma')">
                                    <i class="bi bi-hdd-stack-fill text-danger"></i>
                                    <div class="small fw-bold">Kas Yap</div>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="goal-card text-center" onclick="selectGoal(this, 'Yağ Yakımı ve Sıkılaşma')">
                                    <i class="bi bi-fire text-danger"></i>
                                    <div class="small fw-bold">Sıkılaş</div>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="goal-card text-center" onclick="selectGoal(this, 'Sağlıklı Yaşam')">
                                    <i class="bi bi-heart-pulse-fill text-success"></i>
                                    <div class="small fw-bold">Sağlık</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <button type="submit" id="btnAnaliz" class="btn-generate">
                        <i class="bi bi-cpu-fill me-2"></i> Analizi Başlat
                    </button>
                </form>
            </div>

            <!-- SAĞ TARAF: ÇIKTI PANELİ -->
            <div class="col-lg-8 p-4 p-md-5 bg-light position-relative">

                <!-- DURUM 1: Bekleme / Yükleme Ekranı -->
                <div id="loadingArea" style="display:none;" class="h-100">
                    <div class="ai-loader">
                        <div class="pulse-ring mb-4"></div>
                        <h5 class="fw-bold text-dark">Neural Engine Çalışıyor...</h5>
                        <p class="text-muted small">Veriler Google Cloud sunucularında işleniyor</p>
                        <div class="mt-3 text-start ps-5 pe-5" style="width:100%; max-width:400px;">
                            <small class="text-muted d-block mb-1"><i class="bi bi-check2 text-success"></i> Biyometrik veriler alındı</small>
                            <small class="text-muted d-block mb-1"><i class="bi bi-check2 text-success"></i> Hedef analizi yapıldı</small>
                            <small class="text-muted d-block loading-text"><i class="bi bi-arrow-repeat"></i> Program oluşturuluyor...</small>
                        </div>
                    </div>
                </div>

                <!-- DURUM 2: Sonuç Ekranı -->
                @if (ViewBag.Sonuc != null)
                {
                    <div class="ai-output-area h-100 d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
                            <div>
                                <h3 class="fw-bold m-0 text-dark">Sonuç Raporu</h3>
                                <small class="text-muted">ID: @Guid.NewGuid().ToString().Substring(0, 8).ToUpper() | @DateTime.Now.ToString("dd.MM.yyyy HH:mm")</small>
                            </div>
                            <a asp-controller="Home" asp-action="Index" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                                <i class="bi bi-save me-1"></i> Kaydet
                            </a>
                        </div>

                        <div class="flex-grow-1 overflow-auto pe-2 ai-typing">
                            <!-- AI Çıktısı Buraya -->
                            @ViewBag.Sonuc
                        </div>

                        <div class="mt-4 pt-3 border-top">
                            <div class="alert alert-light border d-flex align-items-center mb-0">
                                <i class="bi bi-info-circle-fill text-primary fs-4 me-3"></i>
                                <div class="small text-muted">
                                    Bu program <strong>Yapay Zeka</strong> tarafından oluşturulmuştur. Profesyonel bir eğitmen ile görüşerek programı doğrulamanız önerilir.
                                </div>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <!-- DURUM 3: Boş Ekran (İlk Açılış) -->
                    <div id="emptyState" class="h-100 d-flex flex-column justify-content-center align-items-center text-center opacity-50">
                        <img src="https://cdn-icons-png.flaticon.com/512/2103/2103633.png" width="120" class="mb-4 grayscale" style="filter: grayscale(100%); opacity: 0.5;">
                        <h3 class="fw-bold">Sistem Hazır</h3>
                        <p class="col-8 mx-auto">Sol taraftaki panelden parametreleri girerek yapay zeka motorunu başlatın.</p>
                    </div>
                }

            </div>
        </div>
    </div>
</div>

<!-- JAVASCRIPT: Sayfa İçi Etkileşimler -->
<script>
    // Hedef Kartlarını Seçme Mantığı
    function selectGoal(element, goalValue) {
        // Tüm kartlardan active sınıfını kaldır
        document.querySelectorAll('.goal-card').forEach(el => el.classList.remove('active'));

        // Tıklanana ekle
        element.classList.add('active');

        // Gizli inputa değeri yaz
        document.getElementById('selectedGoal').value = goalValue;
    }

    // Yükleme Animasyonunu Başlat
    function startProcessing() {
        document.getElementById('btnAnaliz').disabled = true;
        document.getElementById('btnAnaliz').innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span> İşleniyor...';

        // Boş durumu gizle
        var emptyState = document.getElementById('emptyState');
        if(emptyState) emptyState.style.display = 'none';

        // Loading'i göster
        document.getElementById('loadingArea').style.display = 'flex';
    }
</script>