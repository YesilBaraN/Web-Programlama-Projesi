@{
    ViewData["Title"] = "AI Neural Coach";
}

<style>
    /* --- ARKA PLAN VE TEMEL AYARLAR --- */
    body {
        background-color: #0f0c29;
        background-image: linear-gradient(315deg, #0f0c29 0%, #302b63 74%, #24243e 100%);
        min-height: 100vh;
        color: #fff;
        font-family: 'Poppins', sans-serif;
    }

    /* --- CAM EFEKTİ (GLASSMORPHISM) PANELİ --- */
    .glass-panel {
        background: rgba(255, 255, 255, 0.05);
        backdrop-filter: blur(20px); /* Bulanıklık arttırıldı */
        -webkit-backdrop-filter: blur(20px);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 24px;
        overflow: hidden;
        box-shadow: 0 0 40px rgba(0,0,0,0.5);
    }

    /* --- SOL PANEL (KONTROL) --- */
    .control-panel {
        background: rgba(0, 0, 0, 0.2);
        border-right: 1px solid rgba(255, 255, 255, 0.05);
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

    /* --- INPUT VE SELECT AYARLARI (DÜZELTİLDİ) --- */
    .form-label-custom {
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 1.5px;
        color: #a8b2d1;
        font-weight: 600;
        margin-bottom: 8px;
    }

    .custom-input, .form-select {
        background: rgba(255, 255, 255, 0.1) !important; /* Hafif şeffaf */
        border: 1px solid rgba(255, 255, 255, 0.2) !important;
        color: #fff !important; /* Yazı rengi beyaz */
        border-radius: 12px;
        padding: 12px;
    }

        .custom-input:focus, .form-select:focus {
            background: rgba(255, 255, 255, 0.2) !important;
            border-color: #00c6ff !important;
            box-shadow: 0 0 10px rgba(0, 198, 255, 0.3);
            outline: none;
        }

        /* --- KRİTİK DÜZELTME: SELECT OPTION GÖRÜNÜRLÜĞÜ --- */
        /* Seçenekler açıldığında arka planı koyu yapıyoruz ki beyaz yazı okunsun */
        .form-select option {
            background-color: #24243e; /* Koyu Lacivert */
            color: #fff;
            padding: 10px;
        }

    /* --- BUTON TASARIMI --- */
    .btn-generate {
        background: linear-gradient(135deg, #00c6ff 0%, #0072ff 100%);
        color: white;
        border: none;
        padding: 15px;
        border-radius: 12px;
        font-weight: 700;
        letter-spacing: 1px;
        width: 100%;
        transition: all 0.3s ease;
        margin-top: 20px;
        box-shadow: 0 4px 15px rgba(0, 114, 255, 0.3);
    }

        .btn-generate:hover {
            transform: translateY(-2px);
            box-shadow: 0 0 25px rgba(0, 114, 255, 0.6);
            color: white;
        }

    /* --- SAĞ TARAF & RESİM (DÜZELTİLDİ) --- */
    .result-image {
        width: 100%;
        /* max-height sınırını kaldırdık veya çok arttırdık */
        height: auto;
        min-height: 400px; /* En az bu kadar olsun */
        object-fit: cover;
        border-radius: 15px;
        border: 1px solid rgba(255,255,255,0.3);
        box-shadow: 0 15px 40px rgba(0,0,0,0.6);
        margin-bottom: 20px;
        animation: zoomIn 0.8s ease;
    }

    .result-text-box {
        background: rgba(0,0,0,0.4);
        padding: 25px;
        border-radius: 15px;
        font-family: 'Courier New', Courier, monospace;
        font-size: 0.95rem;
        line-height: 1.7;
        color: #e2e8f0;
        border-left: 4px solid #00c6ff;
        max-height: 500px; /* Metin kutusu çok uzamasın, scroll çıksın */
        overflow-y: auto;
    }

    /* --- ANİMASYONLAR --- */
    @@keyframes zoomIn {
        from {
            opacity: 0;
            transform: scale(0.95);
        }

        to {
            opacity: 1;
            transform: scale(1);
        }
    }

    .fade-in {
        animation: fadeIn 1s ease-in-out;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
        }

        to {
            opacity: 1;
        }
    }

    .loader-overlay {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(15, 12, 41, 0.9); /* Arka planı biraz daha kararttık */
        display: flex;
        justify-content: center;
        align-items: center;
        flex-direction: column;
        z-index: 20;
        backdrop-filter: blur(8px);
        border-radius: 24px;
    }
</style>

<div class="container py-5">
    <div class="text-center mb-5">
        <h1 class="display-4 fw-bold text-white">AI <span style="color:#00c6ff;">NEURAL</span> COACH</h1>
        <p class="text-white-50">Hedefini seç, Yapay Zeka hem planını yazsın hem geleceğini çizsin.</p>
    </div>

    <div class="glass-panel">
        <div class="row g-0">

            <!-- SOL: FORM -->
            <div class="col-lg-4 p-5 control-panel">
                <form asp-action="AnalizYap" method="post" onsubmit="startLoading()">

                    <div class="mb-4">
                        <label class="form-label-custom">KİMLİK</label>
                        <!-- DÜZELTME: Option'ların arka planı CSS ile düzeltildi -->
                        <select name="cinsiyet" class="form-select form-select-lg">
                            <option value="Erkek">Erkek</option>
                            <option value="Kadın">Kadın</option>
                        </select>
                    </div>

                    <div class="mb-4">
                        <label class="form-label-custom">METRİKLER</label>
                        <div class="row g-2">
                            <div class="col-4">
                                <input type="number" name="yas" class="form-control custom-input text-center" placeholder="Yaş" value="@ViewBag.Yas" required>
                            </div>
                            <div class="col-4">
                                <input type="number" name="kilo" class="form-control custom-input text-center" placeholder="Kg" value="@ViewBag.Kilo" required>
                            </div>
                            <div class="col-4">
                                <input type="number" name="boy" class="form-control custom-input text-center" placeholder="Cm" value="@ViewBag.Boy" required>
                            </div>
                        </div>
                    </div>

                    <div class="mb-5">
                        <label class="form-label-custom">ANA HEDEF</label>
                        <!-- DÜZELTME: Dropdown açılınca yazılar okunacak -->
                        <select name="hedef" class="form-select form-select-lg">
                            <option value="Hızlı Kilo Verme">🏃 Hızlı Kilo Verme (Yağ Yakımı)</option>
                            <option value="Kas Kütlesi Kazanma">💪 Kas Yapma / Hacim</option>
                            <option value="Sıkılaşma ve Fit Görünüm">🧘 Sıkılaşma / Fit Görünüm</option>
                        </select>
                    </div>

                    <button type="submit" class="btn-generate py-3">
                        ANALİZ & ÜRETİM BAŞLAT <i class="bi bi-arrow-right-short"></i>
                    </button>
                </form>
            </div>

            <!-- SAĞ: SONUÇ EKRANI -->
            <div class="col-lg-8 p-5 position-relative" style="min-height: 600px;">

                <!-- LOADING -->
                <div id="loadingOverlay" class="loader-overlay" style="display:none;">
                    <div class="spinner-border text-info mb-4" style="width: 4rem; height: 4rem;" role="status"></div>
                    <h4 class="text-white fw-light letter-spacing-1">SİNİR AĞLARI ÇALIŞIYOR...</h4>
                    <small class="text-white-50 mt-2">Vücut analizi yapılıyor ve görsel oluşturuluyor.</small>
                </div>

                @if (ViewBag.Sonuc != null)
                {
                    <div class="h-100 d-flex flex-column fade-in">

                        <!-- 1. RESİM ALANI (Boyutu büyütüldü) -->
                        @if (ViewBag.UretilenResim != null)
                        {
                            <div class="text-center mb-4">
                                <div class="d-flex justify-content-between align-items-center mb-2 px-2">
                                    <span class="badge bg-warning text-dark"><i class="bi bi-stars"></i> HEDEF GÖRÜNTÜN</span>
                                    <a href="@ViewBag.UretilenResim" target="_blank" class="btn btn-sm btn-outline-light rounded-pill px-3">
                                        <i class="bi bi-download"></i> İndir
                                    </a>
                                </div>
                                <!-- DÜZELTME: Resim artık kutuya sığıyor ve büyük görünüyor -->
                                <img src="@ViewBag.UretilenResim" class="result-image" alt="AI Generated Fitness Goal">
                            </div>
                        }

                        <!-- 2. METİN PLANI -->
                        <div class="result-text-box flex-grow-1">
                            <h6 class="text-info mb-3 border-bottom border-secondary pb-2">📋 YAPAY ZEKA RAPORU</h6>
                            @ViewBag.Sonuc
                        </div>

                        <div class="mt-3 text-end">
                            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-success px-4 rounded-pill">
                                <i class="bi bi-check2-circle me-2"></i>Planı Uygula
                            </a>
                        </div>
                    </div>
                }
                else
                {
                    <!-- BOŞ DURUM -->
                    <div class="h-100 d-flex flex-column align-items-center justify-content-center opacity-50 text-center">
                        <i class="bi bi-cpu display-1 mb-4 text-white" style="font-size: 5rem;"></i>
                        <h3 class="fw-light mb-3">SİSTEM HAZIR</h3>
                        <p class="text-white-50 w-75 mx-auto fs-5">
                            Sol panelden verilerinizi girin. <br>
                            <strong>Google Gemini</strong> size özel bir plan yazacak ve
                            gelecekteki halinizi foto gerçekçi olarak çizecek.
                        </p>
                    </div>
                }
            </div>

        </div>
    </div>
</div>

<script>
    function startLoading() {
        // Loading ekranını göster
        document.getElementById('loadingOverlay').style.display = 'flex';
        // Butonu pasif yap (Çift tıklamayı önlemek için)
        document.querySelector('.btn-generate').disabled = true;
        document.querySelector('.btn-generate').innerHTML = 'İŞLENİYOR...';
    }
</script>