@{
    ViewData["Title"] = "Gizlilik Politikası";
}

<div class="container mt-5 mb-5">
    <div class="card shadow-sm border-0 rounded-4">
        <div class="card-header bg-white p-4 border-bottom">
            <h2 class="fw-bold mb-0 text-primary"><i class="bi bi-shield-check me-2"></i>Gizlilik ve Güvenlik Politikası</h2>
        </div>
        <div class="card-body p-4">
            <p class="lead text-muted">FitnessPro olarak verilerinizin güvenliğine büyük önem veriyoruz.</p>

            <hr />

            <div class="row g-4 mt-2">
                <div class="col-md-6">
                    <h5 class="fw-bold"><i class="bi bi-hdd-network me-2 text-info"></i>Veri Toplama</h5>
                    <p class="small text-secondary">
                        Üyelik işlemi sırasında ad, soyad ve e-posta bilgileriniz alınmaktadır.
                        Yapay zeka koçluk hizmeti için girilen boy, kilo ve yaş verileri sadece analiz amaçlı kullanılır ve üçüncü taraflarla paylaşılmaz.
                    </p>
                </div>
                <div class="col-md-6">
                    <h5 class="fw-bold"><i class="bi bi-lock me-2 text-danger"></i>Güvenlik</h5>
                    <p class="small text-secondary">
                        Şifreleriniz veritabanımızda <strong>Hash</strong>lenmiş (şifrelenmiş) olarak saklanır.
                        Yönetim ekibi dahil kimse şifrenizi göremez.
                    </p>
                </div>
                <div class="col-md-6">
                    <h5 class="fw-bold"><i class="bi bi-robot me-2 text-primary"></i>Yapay Zeka Kullanımı</h5>
                    <p class="small text-secondary">
                        Google Gemini entegrasyonumuz, verilerinizi anonim olarak işler.
                        Kişisel kimlik bilgileriniz yapay zeka modelleriyle doğrudan ilişkilendirilmez.
                    </p>
                </div>
                <div class="col-md-6">
                    <h5 class="fw-bold"><i class="bi bi-cookie me-2 text-warning"></i>Çerezler</h5>
                    <p class="small text-secondary">
                        Sitemizde kullanıcı deneyimini artırmak ve oturumunuzu açık tutmak için zorunlu çerezler kullanılmaktadır.
                    </p>
                </div>
            </div>

            <div class="alert alert-light border mt-4 text-center">
                <small>Son Güncelleme: @DateTime.Now.ToString("dd MMMM yyyy")</small>
            </div>
        </div>
    </div>
</div>