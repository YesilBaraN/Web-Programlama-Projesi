@model FitnessProje.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Kayıt Ol";
}

<div class="row justify-content-center align-items-center" style="min-height: 80vh;">
    <div class="col-md-6">
        <div class="card shadow-lg border-0 rounded-4">
            <div class="card-body p-5">
                <div class="text-center mb-4">
                    <h3 class="fw-bold text-primary">Aramıza Katıl</h3>
                    <p class="text-muted">Fitness yolculuğuna bugün başla</p>
                </div>

                <form asp-action="Register" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger small rounded-3"></div>

                    <div class="row g-2 mb-3">
                        <div class="col-md-6">
                            <div class="form-floating">
                                <input asp-for="Ad" class="form-control rounded-3" placeholder="Ad" />
                                <label asp-for="Ad">Ad</label>
                            </div>
                            <span asp-validation-for="Ad" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <div class="form-floating">
                                <input asp-for="Soyad" class="form-control rounded-3" placeholder="Soyad" />
                                <label asp-for="Soyad">Soyad</label>
                            </div>
                            <span asp-validation-for="Soyad" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="form-floating mb-3">
                        <input asp-for="Email" class="form-control rounded-3" placeholder="name@example.com" />
                        <label asp-for="Email">E-Posta Adresi</label>
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="row g-2 mb-4">
                        <div class="col-md-6">
                            <div class="form-floating">
                                <input asp-for="Sifre" type="password" class="form-control rounded-3" placeholder="Şifre" />
                                <label asp-for="Sifre">Şifre</label>
                            </div>
                            <span asp-validation-for="Sifre" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <div class="form-floating">
                                <input asp-for="SifreTekrar" type="password" class="form-control rounded-3" placeholder="Tekrar" />
                                <label asp-for="SifreTekrar">Şifre Tekrar</label>
                            </div>
                            <span asp-validation-for="SifreTekrar" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="d-grid">
                        <button type="submit" class="btn btn-success btn-lg rounded-pill shadow-sm">Kayıt Ol</button>
                    </div>
                </form>
                <div class="text-center mt-4">
                    <small class="text-muted">Zaten üye misin? <a asp-action="Login" class="text-decoration-none fw-bold">Giriş Yap</a></small>
                </div>
            </div>
        </div>
    </div>
</div>