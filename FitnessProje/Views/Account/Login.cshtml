@model FitnessProje.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Giriş Yap";
}

<div class="row justify-content-center align-items-center" style="min-height: 70vh;">
    <div class="col-md-5">
        <div class="card shadow-lg border-0 rounded-4">
            <div class="card-body p-5">
                <div class="text-center mb-4">
                    <div class="bg-primary text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 60px; height: 60px;">
                        <i class="bi bi-person-circle fs-2"></i>
                    </div>
                    <h3 class="fw-bold text-dark">Hoş Geldiniz</h3>
                    <p class="text-muted">Hesabınıza giriş yapın</p>
                </div>

                <form asp-action="Login" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger small rounded-3"></div>

                    <div class="form-floating mb-3">
                        <input asp-for="Email" class="form-control rounded-3" placeholder="name@example.com" />
                        <label asp-for="Email">E-Posta Adresi</label>
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="form-floating mb-3">
                        <input asp-for="Sifre" type="password" class="form-control rounded-3" placeholder="Şifre" />
                        <label asp-for="Sifre">Şifre</label>
                        <span asp-validation-for="Sifre" class="text-danger small"></span>
                    </div>

                    <div class="form-check mb-3">
                        <input class="form-check-input" type="checkbox" asp-for="BeniHatirla" />
                        <label class="form-check-label text-muted" asp-for="BeniHatirla">Beni Hatırla</label>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary btn-lg rounded-pill shadow-sm">Giriş Yap</button>
                        <a asp-action="Register" class="btn btn-outline-secondary btn-lg rounded-pill border-0">Hesap Oluştur</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>