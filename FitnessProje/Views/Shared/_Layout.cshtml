@using Microsoft.AspNetCore.Identity
@using FitnessProje.Data
@inject ApplicationDbContext _db
@inject UserManager<FitnessProje.Models.UygulamaKullanıcı> _userManager

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - FitnessPro</title>
    <!-- AOS Animasyon CSS -->
    <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">
    <!-- 1. BOOTSTRAP CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- 2. MODERN FONT (POPPINS) -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <!-- 3. İKONLAR -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <!-- 4. BİZİM CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<!-- KRİTİK NOKTA: d-flex ve min-vh-100 sınıfı sayfayı ekran boyuna yayar -->
<body class="d-flex flex-column min-vh-100">

    <!-- SAYFA YÜKLENİYOR EKRANI -->
    <div id="preloader" style="position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: #ffffff; z-index: 9999; display: flex; justify-content: center; align-items: center; transition: opacity 0.5s ease;">
        <div class="text-center">
            <div class="spinner-border text-primary" style="width: 3rem; height: 3rem;" role="status"></div>
            <h5 class="mt-3 fw-bold text-dark" style="letter-spacing: 2px;">FITNESS PRO</h5>
        </div>
    </div>

    <script>
        // Sayfa tamamen yüklendiğinde loader'ı kaldır
        window.addEventListener('load', function () {
            var loader = document.getElementById('preloader');
            loader.style.opacity = '0';
            setTimeout(function () {
                loader.style.display = 'none';
            }, 500);
        });
    </script>
    <!-- NAVBAR (MENÜ) -->
    <header>
        <nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm py-3">
            <div class="container">
                <a class="navbar-brand fw-bold text-primary fs-4" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-activity"></i> FitnessPro
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link text-dark fw-medium" asp-controller="Home" asp-action="Index">Ana Sayfa</a>
                        </li>
                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-danger fw-bold" href="#" role="button" data-bs-toggle="dropdown">
                                    Yönetim Paneli
                                </a>
                                <ul class="dropdown-menu border-0 shadow">
                                    <li><a class="dropdown-item" asp-controller="Hizmetler" asp-action="Index">Hizmet Yönetimi</a></li>
                                    <li><a class="dropdown-item" asp-controller="Antrenörler" asp-action="Index">Antrenör Yönetimi</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item" asp-controller="Randevu" asp-action="Yonetim">Randevu Talepleri</a></li>
                                </ul>
                            </li>
                        }
                    </ul>

                    <div class="d-flex align-items-center gap-2">
                        @if (User.Identity.IsAuthenticated)
                        {
                            <span class="text-muted small me-2">Merhaba, <strong>@User.Identity.Name</strong></span>

                            <a class="btn btn-outline-primary btn-sm rounded-pill" asp-controller="YapayZeka" asp-action="Index">
                                <i class="bi bi-robot"></i> AI Koç
                            </a>
                            <a class="btn btn-outline-dark btn-sm rounded-pill" asp-controller="Randevu" asp-action="Index">
                                Randevularım
                            </a>
                            <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                <button type="submit" class="btn btn-link text-danger text-decoration-none fw-bold btn-sm">Çıkış</button>
                            </form>
                        }
                        else
                        {
                            <a class="btn btn-outline-dark btn-sm rounded-pill px-3" asp-controller="Account" asp-action="Login">Giriş</a>
                            <a class="btn btn-primary btn-sm rounded-pill px-3" asp-controller="Account" asp-action="Register">Kayıt Ol</a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <!-- İÇERİK ALANI (flex-grow-1: Boşluğu doldurur ve footer'ı aşağı iter) -->
    <main class="flex-grow-1">
        <div class="container py-4">
            @RenderBody()
        </div>
    </main>

    <!-- FOOTER (ALT BİLGİ) -->
    <footer class="bg-dark text-white py-4 mt-auto">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-md-6 text-center text-md-start">
                    <p class="mb-0 small">&copy; 2025 <strong>FitnessPro</strong>. Tüm hakları saklıdır.</p>
                </div>
                <div class="col-md-6 text-center text-md-end mt-2 mt-md-0">
                    <a href="#" class="text-white-50 me-3"><i class="bi bi-instagram"></i></a>
                    <a href="#" class="text-white-50 me-3"><i class="bi bi-twitter-x"></i></a>
                    <a asp-controller="Home" asp-action="Privacy" class="text-white-50 small text-decoration-none">Gizlilik Politikası</a>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <!-- 1. SWEETALERT KÜTÜPHANESİ -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <!-- 2. OTOMATİK BİLDİRİM YAKALAYICI -->
    <script>
        
        // Başarılı Mesajı (Success)
        @if (TempData["Basarili"] != null)
        {
            <text>
                Swal.fire({
                    title: 'Harika!',
                    text: '@TempData["Basarili"]',
                    icon: 'success',
                    confirmButtonText: 'Tamam',
                    confirmButtonColor: '#2c3e50'
                });
            </text>
        }

        // Hata Mesajı (Error)
        @if (TempData["Hata"] != null)
        {
            <text>
                Swal.fire({
                    title: 'Ops!',
                    text: '@TempData["Hata"]',
                    icon: 'error',
                    confirmButtonText: 'Tamam',
                    confirmButtonColor: '#e74c3c'
                });
            </text>
        }

        // --- BURADAN BAŞLA: ADMIN ZORLA SİLME ONAYI (YENİ EKLENECEK KISIM) ---
        @if (TempData["SilmeOnayiGerekli"] != null && (bool)TempData["SilmeOnayiGerekli"] == true)
        {
            <text>
                Swal.fire({
                    title: '⚠️ Kritik İşlem Onayı',
                    html: '@Html.Raw(TempData["UyariMesaji"])',
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#d33',
                    cancelButtonColor: '#3085d6',
                    confirmButtonText: 'Evet, Risk Alıyorum ve Siliyorum!',
                    cancelButtonText: 'Vazgeç',
                    focusCancel: true
                }).then((result) => {
                    if (result.isConfirmed) {
                        var form = document.createElement('form');
                        form.method = 'POST';
                        var controller = '@TempData["SilinecekTur"]' == 'Antrenor' ? '/Antrenörler/ForceDelete' : '/Hizmetler/ForceDelete';
                        form.action = controller;

                        var input = document.createElement('input');
                        input.type = 'hidden';
                        input.name = 'id';
                        input.value = '@TempData["SilinecekId"]';

                        form.appendChild(input);
                        document.body.appendChild(form);
                        form.submit();
                    }
                });
            </text>
        }
        // --- BURADA BİTİYOR ---

    </script>

    @await RenderSectionAsync("Scripts", required: false)
    <!-- AOS Animasyon JS -->
    <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
    <script>
        AOS.init({
          duration: 800, // Animasyon süresi (milisaniye)
          once: true,    // Sadece bir kere çalışsın (aşağı yukarı yapınca tekrar etmesin)
          easing: 'ease-out-cubic'
        });
    </script>
    <!-- KULLANICI BİLDİRİM KONTROLÜ -->
    @if (User.Identity.IsAuthenticated && !User.IsInRole("Admin"))
    {
        // Giriş yapan kullanıcının ID'sini al
        var user = await _userManager.GetUserAsync(User);
        if (user != null)
        {
            // Okunmamış bildirimleri çek
            var bildirimler = _db.Bildirimler
            .Where(b => b.UyeId == user.Id && !b.OkunduMu)
            .ToList();

            if (bildirimler.Any())
            {
                // Mesajları birleştir
                var mesaj = string.Join("<br><br>", bildirimler.Select(b => b.Mesaj));

                // Bildirimleri okundu olarak işaretle
                foreach (var b in bildirimler) { b.OkunduMu = true; }
                await _db.SaveChangesAsync();

                <script>
                    document.addEventListener("DOMContentLoaded", function() {
                        Swal.fire({
                            title: 'Önemli Bildirim',
                            html: '@Html.Raw(mesaj)',
                            icon: 'info',
                            confirmButtonText: 'Anladım'
                        });
                    });
                </script>
            }
        }
    }
</body>
</html>